

# ── Entorno y servidor ─────────────────────────────
NODE_ENV=development            # development | production
PORT=3000
TZ=America/Tijuana

# ── Base de datos PostgreSQL ───────────────────────
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@localhost:5432/saasc_db
DB_SSL_REJECT_UNAUTHORIZED=true # false para certificados autofirmados
DB_POOL_MAX=10

# ── Dominio y CORS ─────────────────────────────────
PUBLIC_BASE_URL=http://localhost:3000          # En producción debe ser https://
ALLOWED_ORIGINS=http://localhost:5174          # Separados por comas

# ── Autenticación ──────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Bootstrap del superadministrador ───────────────
# Se recomienda borrar la contraseña después del primer inicio.
SUPERADMIN_EMAIL=admin@ejemplo.com
SUPERADMIN_PASSWORD=

# ── Almacenamiento de archivos (AWS S3 o compatible) ─
AWS_REGION=us-west-2
AWS_S3_BUCKET=nombre-de-tu-bucket
# Déjalas vacías si usas roles de IAM dentro de AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=                   # Opcional, para almacenamiento compatible con S3
AWS_FORCE_PATH_STYLE=false

# ── Meta / WhatsApp Business Cloud API ─────────────
WHATSAPP_VERIFY_TOKEN=          # Cadena aleatoria que tú defines para verificar el webhook
WHATSAPP_TOKEN=                 # Token de acceso de la app de Meta
PHONE_NUMBER_ID=                # ID del número en WhatsApp Business
WHATSAPP_PUBLIC_NUMBER=52XXXXXXXXXX
META_APP_SECRET=
# Plantilla aprobada por Meta con 3 variables: residente, departamento y folio.
WHATSAPP_PAYMENT_PROOF_TEMPLATE=nuevo_comprobante_presidente
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# ── OpenAI (opcional: activa las funciones de IA) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
